<Application x:Class="GreenLumaPresets.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GreenLumaPresets"
             xmlns:converters="clr-namespace:GreenLumaPresets.Views.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <SolidColorBrush x:Key="SteamWindowBackground" Color="#394333"/>
        <SolidColorBrush x:Key="SteamPanelBackground" Color="#2D3427"/>
        <SolidColorBrush x:Key="SteamPanelInner" Color="#242A1F"/>
        <SolidColorBrush x:Key="SteamMenuBackground" Color="#2A3125"/>
        <SolidColorBrush x:Key="SteamText" Color="#E6F2D5"/>
        <SolidColorBrush x:Key="SteamMutedText" Color="#B7C3AD"/>
        <SolidColorBrush x:Key="SteamBorder" Color="#5C6A52"/>
        <SolidColorBrush x:Key="SteamSelection" Color="#5E7734"/>
        <SolidColorBrush x:Key="SteamSelectionHover" Color="#6B8440"/>
        <SolidColorBrush x:Key="SteamAccent" Color="#9BCB46"/>
        <SolidColorBrush x:Key="SteamRow" Color="#2B3326"/>
        <SolidColorBrush x:Key="SteamRowAlt" Color="#273021"/>
        <SolidColorBrush x:Key="SteamButtonBackground" Color="#424C3B"/>
        <SolidColorBrush x:Key="SteamButtonHover" Color="#475141"/>
        <SolidColorBrush x:Key="SteamButtonPressed" Color="#30382B"/>
        <SolidColorBrush x:Key="SteamButtonHighlight" Color="#C7D5B9"/>
        <SolidColorBrush x:Key="SteamButtonShadow" Color="#13180F"/>
        <SolidColorBrush x:Key="SteamButtonOuterBorder" Color="#0F130C"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{DynamicResource SteamWindowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource SteamPanelInner}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource SteamSelection}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="RenameArea" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="False">
                    <Setter Property="IsReadOnly" Value="True"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SteamButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Height" Value="23"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Outer"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                                        <Border x:Name="TopLeftHighlight"
                                    Margin="1"
                                    BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource SteamButtonHighlight}"
                                            Opacity="0.45"/>
                                    <Border x:Name="BottomRightShadow"
                                    Margin="1"
                                    BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource SteamButtonShadow}"
                                        Opacity="0.7"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopLeftHighlight" Property="BorderBrush" Value="{DynamicResource SteamButtonShadow}"/>
                                <Setter TargetName="TopLeftHighlight" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="BottomRightShadow" Property="BorderBrush" Value="{DynamicResource SteamButtonHighlight}"/>
                                <Setter TargetName="BottomRightShadow" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteamButtonHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteamButtonPressed}"/>
                    <Setter Property="Padding" Value="13,3,11,1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource SteamMutedText}"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteamButtonHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource SteamPanelBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,4,2,4"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}"/>
                                <Border Margin="1"
                                        BorderThickness="1,1,0,0"
                                    BorderBrush="{DynamicResource SteamButtonShadow}"
                                        Opacity="0.7"/>
                                <Border Margin="1"
                                    BorderThickness="0,0,1,1"
                                    BorderBrush="{DynamicResource SteamButtonHighlight}"
                                        Opacity="0.5"/>
                            <ScrollViewer Padding="{TemplateBinding Padding}" 
                    Margin="{TemplateBinding Margin}" 
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}" 
                    VerticalAlignment="{TemplateBinding VerticalAlignment}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource SteamRow}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource SteamRowAlt}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteamSelectionHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SteamSelection}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SteamMenuBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SteamBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer CanContentScroll="True"
                                          VerticalScrollBarVisibility="Disabled"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel IsItemsHost="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource SteamWindowBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="MenuItemBorder"
                                    Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource SteamMenuBackground}"
                                        BorderBrush="{DynamicResource SteamButtonShadow}"
                                        BorderThickness="1"
                                        Padding="0,2">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SteamMutedText}"/>
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="{DynamicResource SteamSelectionHover}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsHighlighted" Value="True"/>
                                    <Condition Property="IsEnabled" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="Transparent"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
