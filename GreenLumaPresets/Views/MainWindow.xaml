<Window x:Class="GreenLumaPresets.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:GreenLumaPresets.Views"
        xmlns:vm="clr-namespace:GreenLumaPresets.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GreenLuma Presets" Height="450" Width="800"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource SteamWindowBackground}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Style>
        <Style TargetType="Window">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Cursor" Value="Wait"/>
                    <Setter Property="ForceCursor" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Style>
    <Window.Resources>
        <!-- Context menus are outside the visual tree: they reach the view model through this proxy. -->
        <views:BindingProxy x:Key="ViewModel" Data="{Binding}"/>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource SteamButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="TopLeftHighlight" 
                                    BorderBrush="{DynamicResource SteamButtonHighlight}" 
                                    BorderThickness="1,1,0,0" 
                                    Opacity="0.45"/>
                            <Border x:Name="BottomRightShadow" 
                                    BorderBrush="{DynamicResource SteamButtonShadow}" 
                                    BorderThickness="0,0,1,1" 
                                    Opacity="0.7"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopLeftHighlight" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="BottomRightShadow" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopLeftHighlight" Property="BorderBrush" Value="{DynamicResource SteamButtonShadow}"/>
                                <Setter TargetName="TopLeftHighlight" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="BottomRightShadow" Property="BorderBrush" Value="{DynamicResource SteamButtonHighlight}"/>
                                <Setter TargetName="BottomRightShadow" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border BorderBrush="{DynamicResource SteamButtonHighlight}"
                BorderThickness="1,1,0,0"
                Opacity="0.6"/>
        <Border BorderBrush="{DynamicResource SteamButtonShadow}"
                BorderThickness="0,0,1,1"
                Opacity="0.8"/>
        <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto" MinHeight="35"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

          <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Background="{DynamicResource SteamWindowBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                <TextBlock Text="GreenLuma Presets" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource TitleBarButton}" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeButton_Click"
                        Content="_"/>
                <Button Style="{StaticResource TitleBarButton}" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeButton_Click"
                        Content="▢"/>
                <Button Style="{StaticResource TitleBarButton}" 
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click"
                        Content="X"/>
            </StackPanel>
        </Grid>

        <!-- Menu Bar -->
        <Menu Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource SteamWindowBackground}" Foreground="{DynamicResource SteamText}" Height="24" VerticalAlignment="Top"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="_GreenLuma ▾">
                <MenuItem Header="{Binding InstallUninstallMenuText}" Command="{Binding InstallOrUninstallGreenLumaCommand}"/>
                <MenuItem Header="_Delete Steam cache" Command="{Binding DeleteSteamCacheCommand}"/>
                <MenuItem Header="_Clear IDs from GreenLuma" Command="{Binding ClearAppListCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help ▾">
                <MenuItem Header="_Tutorial" Command="{Binding ShowTutorialCommand}"/>
                <MenuItem Header="_Check for Updates..." Command="{Binding CheckForUpdatesCommand}"/>
                <MenuItem Header="_About" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Border BorderBrush="{DynamicResource SteamButtonHighlight}"
                    BorderThickness="1,1,0,0"
                    Opacity="0.5"/>
            <Border BorderBrush="{DynamicResource SteamButtonShadow}"
                    BorderThickness="0,0,1,1"
                    Opacity="0.7"/>
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

        <!-- Grid for title above the presets list -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
            <TextBlock Text="Presets" FontSize="13" VerticalAlignment="Center"/>
        </Grid>

        <!-- Grid for title above the IDs list -->
        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding SelectedPreset.Name, StringFormat='AppIDs ({0})', FallbackValue='AppIDs'}" FontSize="13" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0">
            <ListBox x:Name="PresetsListBox" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" d:ItemsSource="{d:SampleData ItemCount=5}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBox Text="{Binding Name}" Style="{StaticResource RenameArea}" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Stretch" Margin="0,0,0,0" Padding="0,0,0,0" KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus"
                                 views:EditBehavior.IsEditing="{Binding IsEditing}">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename" Command="{Binding Data.BeginEditCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="Refresh names and icons" Command="{Binding Data.RefreshAppDetailsCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="Delete" Command="{Binding Data.DeletePresetCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ListBox x:Name="IDsListBox" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding SelectedPreset.AppIds}" SelectedItem="{Binding SelectedAppId}"
                 Grid.IsSharedSizeScope="True">
            <ListBox.Resources>
                <ContextMenu x:Key="AppIdMenu" x:Shared="False">
                    <MenuItem Header="Edit AppID" Command="{Binding Data.BeginEditCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding}"/>
                    <MenuItem Header="Rename" Command="{Binding Data.BeginEditCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding Name}"/>
                    <MenuItem Header="Delete" Command="{Binding Data.DeleteAppIdCommand, Source={StaticResource ViewModel}}" CommandParameter="{Binding}"/>
                </ContextMenu>
            </ListBox.Resources>
            <ListBox.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteAppIdCommand}"/>
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" ContextMenu="{StaticResource AppIdMenu}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AppIdValue"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Steam's 32px library icon at half size; the space stays reserved to keep columns aligned. -->
                        <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                               Source="{Binding IconPath, Converter={StaticResource IconPathConverter}}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBox Grid.Column="1" Text="{Binding Value}" MinWidth="60" Style="{StaticResource RenameArea}" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Stretch" Margin="0,0,10,0" Padding="0" KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus"
                                 views:EditBehavior.IsEditing="{Binding IsEditing}" ContextMenu="{StaticResource AppIdMenu}"/>
                        <TextBox Grid.Column="2" Text="{Binding Name.Text}" Style="{StaticResource RenameArea}" Foreground="{DynamicResource SteamMutedText}" Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Stretch" Margin="0" Padding="0" KeyDown="TextBox_KeyDown" LostFocus="TextBox_LostFocus"
                                 views:EditBehavior.Target="{Binding Name}" views:EditBehavior.IsEditing="{Binding Name.IsEditing}" ContextMenu="{StaticResource AppIdMenu}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Grid for buttons below the presets list -->
        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import" Margin="0,0,0,0" Command="{Binding ImportPresetCommand}" Cursor="Hand"/>
            <Button Content="Add" VerticalAlignment="Center" Command="{Binding CreatePresetCommand}"/>
        </StackPanel>

        <!-- Grid for buttons below the IDs list -->
        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Import..." Margin="0,0,0,0" Click="ImportButton_Click" IsEnabled="{Binding HasSelectedPreset}">
                <Button.ContextMenu>
                    <ContextMenu x:Name="ImportContextMenu">
                        <MenuItem Header="Import from Steam" Command="{Binding Data.ImportAppIdsFromSteamCommand, Source={StaticResource ViewModel}}"/>
                        <MenuItem Header="Import from the clipboard" Command="{Binding Data.ImportAppIdsFromClipboardCommand, Source={StaticResource ViewModel}}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Content="Add" VerticalAlignment="Center" Command="{Binding CreateAppIdCommand}"/>
        </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Load" Margin="0,0,0,0" Command="{Binding LoadPresetCommand}"/>
                <Button Content="Load and launch Steam" Margin="5,0,0,0" Command="{Binding LoadAndLaunchSteamCommand}"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
