<Window x:Class="GreenLumaPresets.Views.ImportFromSteamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GreenLumaPresets.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Import From Steam"
        Background="{DynamicResource SteamWindowBackground}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="1,0,1,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource SteamButtonBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource SteamText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="TopLeftHighlight" 
                                    BorderBrush="{DynamicResource SteamButtonHighlight}" 
                                    BorderThickness="1,1,0,0" 
                                    Opacity="0.45"/>
                            <Border x:Name="BottomRightShadow" 
                                    BorderBrush="{DynamicResource SteamButtonShadow}" 
                                    BorderThickness="0,0,1,1" 
                                    Opacity="0.7"/>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center" 
                                            Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TopLeftHighlight" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="BottomRightShadow" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TopLeftHighlight" Property="BorderBrush" Value="{DynamicResource SteamButtonShadow}"/>
                                <Setter TargetName="TopLeftHighlight" Property="Opacity" Value="0.7"/>
                                <Setter TargetName="BottomRightShadow" Property="BorderBrush" Value="{DynamicResource SteamButtonHighlight}"/>
                                <Setter TargetName="BottomRightShadow" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border BorderBrush="{DynamicResource SteamButtonHighlight}"
                BorderThickness="1,1,0,0"
                Opacity="0.6"/>
        <Border BorderBrush="{DynamicResource SteamButtonShadow}"
                BorderThickness="0,0,1,1"
                Opacity="0.8"/>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,5" Background="{DynamicResource SteamWindowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                            MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                    <TextBlock Text="Enter Steam AppID or search by name" Margin="0,0,15,0" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource TitleBarButton}" 
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="CloseButton_Click"
                            Content="X"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Search by name" Padding="0"/>
                <TextBox x:Name="AppNameTextBox" Grid.Row="1" Grid.Column="0" Margin="0,0,5,5" Text="e.g., Counter-Strike 2" Foreground="{DynamicResource SteamMutedText}" GotFocus="AppNameTextBox_GotFocus" LostFocus="AppNameTextBox_LostFocus"/>
                <Button Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Content="Search" Click="SearchButton_Click"/>
                <ListBox x:Name="SearchResultsListBox" Grid.Row="2" Grid.ColumnSpan="2" MinHeight="80" MaxHeight="160" ItemsSource="{Binding SearchResults}" SelectionChanged="SearchResultsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text=" ("/>
                                <TextBlock Text="{Binding AppId}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,5">
                <Label Content="AppID" Padding="0"/>
                <TextBox x:Name="AppIdTextBox" Text="e.g., 730" Foreground="{DynamicResource SteamMutedText}" GotFocus="AppIdTextBox_GotFocus" LostFocus="AppIdTextBox_LostFocus"/>
            </StackPanel>
            <Label Content="{Binding ErrorMessage, Mode=OneWay}" Grid.Row="3" Foreground="Red" Padding="0" FontSize="10" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button Content="OK" Margin="0,0,0,0" Click="OkButton_Click"/>
                <Button Content="Cancel" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
